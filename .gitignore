# Exclude everything by default; explicitly allow tracked paths below.
/*

# Always allow
!.gitignore
!README.md
!voronoi-treemaps.md

# Project config
!package.json
!package-lock.json
!requirements.txt

# Source code
!src/
!src/**
src/__pycache__/

# Data
!data/
!data/**

# Committed example outputs (output/ itself stays a gitignored scratch/build area)
!examples/
!examples/**
