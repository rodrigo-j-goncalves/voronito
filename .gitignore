# Exclude everything by default; explicitly allow tracked paths below.
/*

# Always allow
!.gitignore
!README.md
!voronoi-treemaps.md

# Project config
!package.json
!package-lock.json
!requirements.txt

# 01_data: raw inputs (CSVs, SVG masks)
!01_data/
!01_data/A_raw/
!01_data/A_raw/**

# 02_code: all source (Python + JS)
!02_code/
!02_code/A_analysis/
!02_code/A_analysis/**
02_code/A_analysis/__pycache__/

# 03_output: committed example figures only.
# 03_output/scratch/ stays gitignored -- a personal, regenerable run area.
!03_output/
!03_output/A_figures/
!03_output/A_figures/**
